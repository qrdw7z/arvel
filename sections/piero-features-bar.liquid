<section class="piero-features-bar section-spacing" aria-label="Alışveriş Avantajları">
  <div class="piero-features-grid">
    <div class="piero-feature-item">
      <div class="piero-feature-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="piero-feature-text">
        <h4>{{ section.settings.feature_1_title | default: 'TÜM TÜRKİYE ÜCRETSİZ KARGO' }}</h4>
        <p>{{ section.settings.feature_1_desc | default: 'Hızlı ve sigortalı kargo ile kapınızda' }}</p>
      </div>
    </div>

    <div class="piero-feature-item">
      <div class="piero-feature-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>
      </div>
      <div class="piero-feature-text">
        <h4>{{ section.settings.feature_2_title | default: '%100 DOĞAL & İPEKSİ DOKU' }}</h4>
        <p>{{ section.settings.feature_2_desc | default: 'Nefes alan pamuk, modal ve lüks saten kumaş' }}</p>
      </div>
    </div>

    <div class="piero-feature-item">
      <div class="piero-feature-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.5 2v6h6M21.5 22v-6h-6"></path>
          <path d="M22 11.5A10 10 0 0 0 3.2 7.2M2 12.5a10 10 0 0 0 18.8 4.3"></path>
        </svg>
      </div>
      <div class="piero-feature-text">
        <h4>{{ section.settings.feature_3_title | default: 'KOLAY İADE & DEĞİŞİM' }}</h4>
        <p>{{ section.settings.feature_3_desc | default: '14 gün koşulsuz değişim ve iade garantisi' }}</p>
      </div>
    </div>

    <div class="piero-feature-item">
      <div class="piero-feature-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <div class="piero-feature-text">
        <h4>{{ section.settings.feature_4_title | default: '256-BIT SSL GÜVENLİ ÖDEME' }}</h4>
        <p>{{ section.settings.feature_4_desc | default: '3D Secure güvencesiyle taksitli alışveriş' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Piero Avantajlar Barı",
